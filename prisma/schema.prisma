generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth ─────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("customer")
  status        String    @default("active")
  phone         String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─── Product ──────────────────────────────────────────────────────────────────

enum ProductStatus {
  active
  draft
  archived
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  brand            String
  category         String
  categorySlug     String
  images           String[]
  price            Float
  compareAtPrice   Float?
  description      String           @db.Text
  shortDescription String
  details          String[]
  careInstructions String[]
  shippingInfo     String
  box              String[]
  tags             String[]
  rating           Float            @default(0)
  reviewCount      Int              @default(0)
  stock            Int              @default(0)
  sku              String           @unique
  weight           Float?
  isNew            Boolean          @default(false)
  isFeatured       Boolean          @default(false)
  status           ProductStatus    @default(active)
  variants         ProductVariant[]
  reviews          Review[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  color     String?
  colorHex  String?
  size      String?
  stock     Int     @default(0)
  price     Float?
  sku       String  @unique
  image     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  author    String
  location  String?
  rating    Int
  title     String
  body      String   @db.Text
  verified  Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Category {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  image        String
  description  String?
  productCount Int     @default(0)
}

// ─── Order ────────────────────────────────────────────────────────────────────

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique
  customerId            String
  customerName          String
  customerEmail         String
  subtotal              Float
  shipping              Float
  tax                   Float
  total                 Float
  status                OrderStatus   @default(pending)
  paymentStatus         PaymentStatus @default(pending)
  paymentMethod         String
  shippingAddress       Json
  trackingNumber        String?
  carrier               String?
  notes                 String?
  stripePaymentIntentId String?
  items                 OrderItem[]
  customer              User          @relation(fields: [customerId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  image     String
  price     Float
  quantity  Int
  variant   String?
  sku       String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

// ─── Marketing ────────────────────────────────────────────────────────────────

enum CouponType {
  percentage
  fixed
  free_shipping
  buy_x_get_y
}

enum CouponStatus {
  active
  expired
  disabled
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  type          CouponType
  value         Float
  minOrderValue Float?
  usageLimit    Int?
  usageCount    Int          @default(0)
  expiryDate    DateTime?
  status        CouponStatus @default(active)
  createdAt     DateTime     @default(now())
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── Flash Sales ──────────────────────────────────────────────────────────────

model FlashSale {
  id         String   @id @default(cuid())
  name       String
  discount   Float
  startsAt   DateTime
  endsAt     DateTime
  isActive   Boolean  @default(true)
  productIds String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Email Campaigns ──────────────────────────────────────────────────────────

model EmailCampaign {
  id         String    @id @default(cuid())
  name       String
  subject    String
  status     String    @default("draft")
  sentAt     DateTime?
  recipients Int       @default(0)
  openRate   Float?
  clickRate  Float?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
